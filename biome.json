{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "plugins": [
    { "path": "./scripts/layer-rules.js", "includes": ["app/**"] },
    { "path": "./scripts/layer-css.grit", "includes": ["app/**"] },
    { "path": "./scripts/layer-apply.grit", "includes": ["app/**"] }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!public/favicon.svg"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noReactPropAssignments": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
