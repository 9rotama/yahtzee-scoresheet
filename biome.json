{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "plugins": [
    {
      "path": "./scripts/layer-rules.js",
      "includes": ["app/**"]
    },
    {
      "path": "./scripts/layer-css.grit",
      "includes": ["app/**"]
    },
    {
      "path": "./scripts/layer-apply.grit",
      "includes": ["app/**"]
    },
    {
      "path": "./scripts/hydrate-fallback.grit",
      "includes": ["app/routes/**"]
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!public/favicon.svg"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noReactPropAssignments": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["app/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/routes",
                      "~/routes/**",
                      "**/routes",
                      "**/routes/**"
                    ],
                    "message": "features と components・lib から routes は参照できません。共有するものは参照される側の層へ移してください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["app/components/**", "app/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features",
                      "~/features/**",
                      "**/features",
                      "**/features/**"
                    ],
                    "message": "components と lib から features は参照できません。共有するものは components・lib・models へ移してください。"
                  },
                  {
                    "group": [
                      "~/routes",
                      "~/routes/**",
                      "**/routes",
                      "**/routes/**"
                    ],
                    "message": "features と components・lib から routes は参照できません。共有するものは参照される側の層へ移してください。"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
