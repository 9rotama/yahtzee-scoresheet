{
  "name": "yahtzee-scoresheet",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "node --env-file-if-exists=.env.local scripts/fetch-illustrations.mjs && react-router build",
    "dev": "node --env-file-if-exists=.env.local scripts/fetch-illustrations.mjs && react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome lint",
    "format": "biome format",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-router/node": "^8.5.2",
    "@react-router/serve": "^8.5.2",
    "@tanstack/react-query": "^5.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "isbot": "^5.2.3",
    "lucide-react": "^1.77.0",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@biomejs/biome": "2.6.8",
    "@react-router/dev": "^8.5.2",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/blob": "^2.9.0",
    "babel-plugin-react-compiler": "1.0.0",
    "fake-indexeddb": "^6.2.8",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
